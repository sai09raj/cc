(program
  (def five 5)
  (def mk1 (fun x (let keep (fun z x) (pair (keep true) (keep five)))))
  (def r1 (fst (mk1 7)))
  (def mk2 (fun x (let keep (fun z x) (pair (keep r1) (keep false)))))
  (def r2 (snd (mk2 9)))
  (def mk3 (fun x (let keep (fun z x) (cons (keep r2) (cons (keep 2) nil)))))
  (def r3 (head (mk3 11)))
  (def mk4 (fun x (let keep (fun z x) (pair (keep r3) (keep 0)))))
  (def r4 (fst (mk4 13)))
  (def mk5 (fun x (let keep (fun z x) (pair (keep r4) (keep r1)))))
  (def r5 (fst (mk5 15)))
  (def mk6 (fun x (let keep (fun z x) (cons (keep r5) (cons (keep r2) nil)))))
  (def r6 (head (mk6 17)))
  (def mk7 (fun x (let keep (fun z x) (pair (keep (< r6 0)) (keep r3)))))
  (def r7 (snd (mk7 19)))
  (def mk8 (fun x (let keep (fun z x) (pair (keep r7) (keep (+ r4 r7))))))
  (def r8 (fst (mk8 21)))
  (def mk9 (fun x (let keep (fun z x) (cons (keep r8) (cons (keep r5) nil)))))
  (def r9 (head (mk9 23)))
  (def mk10 (fun x (let keep (fun z x) (pair (keep r9) (keep (== r8 r9))))))
  (def r10 (fst (mk10 25)))
  (def wrap_in_list (fun x (cons x nil)))
  (def list_of_r10 (wrap_in_list r10))
  (def id (fun x x))
  (def use_id_on_r10 (id r10))
  (def alias_id id)
  (def use_alias_id_on_pair (alias_id (pair r10 five)))
)
